```yaml
# spec — machine-readable contract for the feature.
# See SPEC_CONTRACT.yaml for the schema. Fill in every <PLACEHOLDER>.
# This block is the machine source of truth (loader reads the fenced block).

feature_name: <kebab-case-feature-name>               # unique per repo

# scope_authority: claude                             # optional; default "user". Set to "claude" to let
                                                      # the coder make in-spec scope calls without asking
                                                      # (helper extraction, internal naming, fixture choice).
                                                      # NEVER applies to public APIs, permissions, data destruction,
                                                      # library choice, or behavior-changing spec edits — those still surface.

owns:                                                 # every .ts/.tsx the feature owns; repo-relative
  - <web/src/path/to/file.ts>

operation:
  name: "<Human-readable operation name>"             # e.g., "Sign in"
  slug: "<permission-slug | (public) | (internal)>"   # e.g., "(public)" or "admin:user-create"
  description: "<one-line plain English>"

invocation:
  type: <http | ui | server-action | internal>
  # method, path, request_schema, response_schema below — required when type=http
  method: <GET | POST | PUT | PATCH | DELETE>
  path: <"/api/v1/...">
  request_schema: <"./openapi.yaml#/components/schemas/iLoginRequest">
  response_schema: <"./openapi.yaml#/components/schemas/iLoginResponse">

chat_agent:
  when_to_call: "<trigger condition the agent recognizes>"
  when_not_to_call: "<anti-condition>"
  natural_language_examples:
    - "<example user phrase>"
    - "<another example phrase>"
  confirm_before: "<what agent says before invoking; 'none — read-only' for safe reads>"
  summarize_after_success: "<one-line template>"
  summarize_after_failure: "<one-line template>"

cross_cutting:
  wcag: "<sentence OR 'n/a — <reason>'>"
  auth: "<sentence OR 'n/a — <reason>'>"
  mobile: "<sentence OR 'n/a — <reason>'>"
  i18n: "<sentence OR 'n/a — <reason>'>"

links:
  flows:
    - ./flows/<fnName>.flow.yaml
  tests:
    - ../__tests__/<file>.test.ts
  manual:
    - ./manual/<flow>.yaml                            # remove if not UI/HTTP
  openapi: ./openapi.yaml                             # remove if not type=http
  asyncapi: ./asyncapi.yaml                           # remove if no events
```
