# standards-compliance.yaml — per-feature lock + freshness marker.
# See LOCK_FILES.yaml for schema + workflow rules.
# Lives at: <feature-folder>/__specs__/standards-compliance.yaml
#
# REQUIRED FIELDS — the four scalars below PLUS the standards: map (every registered standard). Do NOT add spec/flows/tests/manual/notes;
# the verifiers read only status/verified/last_validated. Narrative belongs in spec.md;
# history belongs in the Changelog story (UI) or git (everything else).
#
# Initial state on file creation: status:unlocked, verified:0%, last_validated empty.
# After completing the full writing-order + manual walk:
#   status: locked
#   verified: 100%
#   last_validated: <UTC ISO-8601 now>

status: unlocked                            # "locked" only after the verify chain is green
verified: "0%"                              # "100%" only when fully verified (no fractional)
last_validated: ""                          # UTC ISO-8601 datetime when locked
feature: <relative/path/to/feature-folder>

# EVERY registered standard, deliberately stamped — none omitted. Verdicts:
#   100%                       the feature meets this standard, verified
#   NOT REQUIRED    this standard does not apply to this feature
browser_validated: ""                       # REQUIRED when the feature ships UI — ISO-8601 UTC, stamped only after the real-browser walk (BROWSER_VALIDATION.yaml)

standards:
