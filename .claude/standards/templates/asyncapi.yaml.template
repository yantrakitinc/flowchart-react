# asyncapi.yaml — per-feature AsyncAPI 3.0 contract.
# Required when the feature emits or subscribes to events.
# Lives at: <feature-folder>/__specs__/asyncapi.yaml
#
# Envelope: CloudEvents v1.0 (specversion / type / source / id / time /
# datacontenttype / data). See SPEC_CONTRACT.yaml + INDUSTRY_STANDARDS_STACK.yaml.

asyncapi: "3.0.0"
info:
  title: <Feature name> event contract
  version: "1.0.0"
  description: <What events this feature emits or subscribes to>

channels:
  <channel-name>:                           # e.g., "user.signed-in"
    address: <channel-name>
    messages:
      <messageName>:
        $ref: "#/components/messages/<messageName>"

operations:
  <operationName>:                          # e.g., "publishUserSignedIn"
    action: <send | receive>
    channel:
      $ref: "#/channels/<channel-name>"

components:
  messages:
    <messageName>:
      contentType: application/cloudevents+json
      payload:
        $ref: "#/components/schemas/<iEventPayload>"

  schemas:
    <iEventPayload>:
      type: object
      required: [specversion, type, source, id, time, datacontenttype, data]
      properties:
        specversion: { const: "1.0" }
        type: { type: string }
        source: { type: string, format: uri }
        id: { type: string }
        time: { type: string, format: date-time }
        datacontenttype: { type: string, const: "application/json" }
        data:
          type: object
          properties:
            <field>: { type: string, description: "<plain English>" }
