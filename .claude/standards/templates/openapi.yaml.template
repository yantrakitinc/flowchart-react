# openapi.yaml — per-feature OpenAPI 3.1 contract.
# Required when invocation.type=http in spec.yaml.
# Lives at: <feature-folder>/__specs__/openapi.yaml
#
# The build step aggregates every <feature>/__specs__/openapi.yaml into
# the project's /openapi.json + /agents.json. See AGENT_AFFORDANCES.yaml.

openapi: "3.1.0"
info:
  title: <Operation name>                   # e.g., "Sign in"
  version: "1.0.0"
  description: <Plain-English description of what this endpoint does>

paths:
  <path>:                                   # e.g., "/api/v1/auth/login"
    <method>:                               # e.g., "post"
      operationId: <fnName>                 # MUST match the symbol in flow.yaml
      summary: <One-line summary>
      description: <Plain-English; the agent reads this>
      tags: [<feature>]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/<iRequest>"
      responses:
        "200":
          description: <success outcome>
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/<iResponse>"
        "401":
          description: <error outcome>
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/iProblemDetails"

components:
  schemas:
    <iRequest>:
      type: object
      required: [<field>]
      properties:
        <field>:
          type: string
          description: <plain English>
    <iResponse>:
      type: object
      properties:
        <field>:
          type: string
    iProblemDetails:                        # RFC 7807; reuse via $ref instead of redefining
      type: object
      required: [type, title, status, code]
      properties:
        type: { type: string, format: uri }
        title: { type: string }
        status: { type: integer }
        detail: { type: string }
        instance: { type: string, format: uri }
        code: { type: string }              # CATEGORY_FEATURE_ERROR shape
