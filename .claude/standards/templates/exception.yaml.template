# <feature>/__specs__/exception.yaml
#
# OPT-IN standards waiver. Present ONLY when a specific, justified case warrants
# excepting a verifier/check for this feature. Absent by default — the bar is full
# compliance; this is the escape hatch of last resort, not a way to lower the bar.
#
# Each entry waives ONE verifier id for THIS feature. The verifier consults this file
# (via _load-exceptions.mjs) and SKIPS the matching violations, logging the reason.
# An entry without a `reason:` does NOT waive anything (a waiver without a reason is
# not a waiver) — it is reported and ignored.
#
# `rule:` is the verifier's id == its script base name. Examples:
#   verify-component-spec | verify-component-tokens | verify-component-state-vocab
#   verify-component-storybook-docs | verify-component-design-locked
#   verify-component-spec-vs-source | verify-composite-composition | ...

exceptions:
  - rule: verify-component-tokens
    reason: >
      <required — the specific, case-by-case justification for this waiver>
    approved_by: <who signed off>
    added: 2026-01-01
