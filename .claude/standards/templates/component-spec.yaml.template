# component spec.yaml — machine-readable IMPLEMENTATION CONTRACT for a design-system
# primitive. Lives at: src/components/ui/<Name>/__specs__/spec.yaml (or package equivalent).
# Schema enforced by verify-component-spec.mjs (requires: public_api, tokens_consumed,
# state_classes_consumed, test_coverage).
#
# spec.yaml is IMPLEMENTATION-ONLY. Design narrative (anatomy/ARIA/keyboard/contrast/edge
# cases/responsive/etc.) goes in design.md; concept + decisions go in spec.md; history goes
# in the Changelog story. See the note at the bottom of this file.
#
# Fill every <PLACEHOLDER>. Delete any optional row that genuinely doesn't apply
# with a one-line "n/a — <reason>" rather than removing the key.

spec_version: 1
component: <ComponentName>                  # PascalCase, matches folder name
package: <package-name>                     # e.g., "@<scope>/<name>"
folder: <repo-relative-path>                # e.g., "packages/extension/src/components/ui/Button"
status: draft                               # flipped to "locked" by verify chain on green
api_shape: <MUI | DaisyUI | shadcn | custom-justified>

# ---------- baseline (when wrapping shadcn) ----------

baseline:
  source: <shadcn/ui ComponentName (style)>  # e.g., "shadcn/ui Button (New York style)"; or "n/a — custom"
  installed_to: <path-or-na>                 # e.g., "src/components/shadcn/button.tsx"; or "n/a"
  hand_edit_rule: never; regenerate via shadcn CLI if updates needed

# ---------- public API (MUI-shaped names per COMPONENT_LIBRARY_DOCTRINE.yaml.component_library.api_shape) ----------

public_api:
  exports:
    - <NamedExport>
    - <iPropsTypeExport>
  props:
    <propName>:
      type: <"enum[…]" | "boolean" | "string" | "number" | "ReactNode" | "() => void">
      default: <value-or-undefined>
      notes: <one-line; remove if obvious from name>
    # repeat per prop
  native_passthrough: <html attrs passed through, or "n/a">
  ref: <forwarded to "<element>" | not forwarded — and why>

# ---------- variant × color × size resolution (when wrapping shadcn) ----------

variant_color_to_baseline_map:
  # one row per (variant.color) combo your public API exposes; value is the baseline variant
  # remove this block entirely if api_shape != shadcn or no baseline
  <variant>.<color>: <baseline_variant_name>

size_to_baseline_map:
  <size>: <baseline_size_name>

# ---------- tokens consumed ----------

tokens_consumed:
  # every CSS var the component's source references; verifier cross-checks against source grep
  - --color-<name>
  - --<other-var>

# ---------- shared state classes consumed ----------

state_classes_consumed:
  # every state-* class the component's source references; verifier cross-checks against source grep
  - state-hover-<contained|outlined|text>
  - state-focus-visible
  - state-disabled
  - state-loading

# ---------- interaction states matrix (OPTIONAL — validated when present) ----------
#
# Optional impl block. When present (component has variant/color/size enums),
# verify-component-spec-matrix-completeness cross-checks rest keys vs declared enums.
# Cells reference token(s) + state-class bindings — never inline values. "n/a" for N/A.

interaction_states:
  rest:
    <variant>.<color>.<size>:
      bg: <--token-or-state-class>
      fg: <--token>
      border: <--token-or-none>
  hover:
    <variant>.<color>.<size>: state-hover-<contained|outlined|text>
  focus_visible:
    <variant>.<color>.<size>: state-focus-visible
  focus_within: <state-class-or-na>
  active:
    <variant>.<color>.<size>: state-active-<contained|outlined|text>
  pressed: <state-class-or-na>
  disabled: state-disabled
  loading: state-loading

# ---------- touch target (OPTIONAL — validated when present) ----------

touch_target_minima:
  wcag_sc: "2.5.8"
  min_px: 24
  per_size:
    <size>: <minimum-CSS-px-or-n/a>

# ---------- contrast pairs (OPTIONAL — validated when present) ----------

wcag_aa_contrast_pairs:
  - combo: <variant.color>
    text_color: <#hex>
    bg_color: <#hex>
    ratio: <computed-ratio>
    rule: <AA_normal | AA_large>
    passes: <true | false>
    deviation: <required when passes:false; one-line why>

# ---------- test coverage (REQUIRED) ----------

test_coverage:
  rule: per-file 100/100/100/100 on <Component>.tsx + types.ts + index.ts
  test_file: src/components/ui/<Name>/__tests__/<Name>.test.tsx
  case_count: <number-of-test-cases>

# =====================================================================================
# NARRATIVE LIVES ELSEWHERE — do NOT put it in spec.yaml (spec.yaml is impl-only):
#   design.md   → anatomy, ARIA pattern, keyboard map, focus ring, a11y invariants,
#                 responsive / forced-colors / reduced-motion / rtl / print handling,
#                 edge cases, deferred variants + rationale  (design_completeness_blocks)
#   spec.md     → concept, exploration, decisions + rationale, out of scope
#   Changelog story → component history (newest-first)
#   __stories__ → Playground (required) + AllVariants (optional) + Changelog (required)
# See COMPONENT_CREATION.yaml.component_spec_schema.narrative_lives_elsewhere.
# =====================================================================================
