{
  "name": "@yantrakit/flowchart-react",
  "version": "2.0.1",
  "description": "Mermaid-like, AI-first React flowchart library — author diagrams as text or object, rendered on React Flow with semantic path detection.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css",
    "./schema": "./schema/flow-graph.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "STORYBOOK_BASE=/flowchart-react/ storybook build -o storybook-static",
    "test:stories": "test-storybook --url http://127.0.0.1:41495 --maxWorkers=2",
    "verify:stories": "start-server-and-test 'storybook dev -p 41495 --no-open --quiet' http://127.0.0.1:41495 'pnpm test:stories'",
    "e2e": "node -e \"console.log('no e2e scope — rendering primitive; E2E_TESTING: NOT REQUIRED (see src/react/__specs__/standards-compliance.md)')\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:run && node scripts/verify-all.mjs && pnpm verify:stories"
  },
  "peerDependencies": {
    "elkjs": ">=0.9.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "elkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test-runner": "^0.22.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "axe-playwright": "^2.2.2",
    "elkjs": "^0.12.0",
    "eslint": "^9.0.0",
    "jsdom": "^28.1.0",
    "playwright": "1.62.0",
    "puppeteer": "^25.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "start-server-and-test": "^2.0.13",
    "storybook": "^8.6.18",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "react",
    "flowchart",
    "diagram",
    "mermaid",
    "auto-layout",
    "visualization",
    "graph"
  ],
  "author": "Yantrakit Inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yantrakitinc/flowchart-react.git"
  },
  "bugs": {
    "url": "https://github.com/yantrakitinc/flowchart-react/issues"
  },
  "homepage": "https://yantrakit.com/flowchart-react",
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5"
  }
}
