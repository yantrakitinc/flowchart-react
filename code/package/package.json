{
  "name": "@yantrakit/flowchart-react",
  "version": "2.0.0",
  "description": "Mermaid-like, AI-first React flowchart: author with text or an object, rendered on React Flow with rich per-node UI and semantic path detection",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css",
    "./schema": "./schema/flow-graph.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "STORYBOOK_BASE=/flowchart-react/ storybook build -o storybook-static",
    "prepare": "git config core.hooksPath code/package/.husky 2>/dev/null || true",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && node scripts/verify-all.mjs",
    "verify:stamp": "node scripts/verify/stamp-standards-met.mjs",
    "ship": "node scripts/ceremony-ship.mjs",
    "pr:standards-block": "node scripts/generate/generate-pr-standards-block.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "elkjs": ">=0.9.0"
  },
  "peerDependenciesMeta": {
    "elkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "elkjs": "^0.12.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "puppeteer": "^25.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^8.6.18",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "react",
    "flowchart",
    "diagram",
    "mermaid",
    "auto-layout",
    "visualization",
    "graph"
  ],
  "author": "Yantrakit Inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yantrakitinc/flowchart-react.git"
  },
  "bugs": {
    "url": "https://github.com/yantrakitinc/flowchart-react/issues"
  },
  "homepage": "https://github.com/yantrakitinc/flowchart-react#readme",
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5"
  }
}
