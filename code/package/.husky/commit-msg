#!/usr/bin/env sh
# DO NOT EDIT — generated by install-slice-gates.sh
# A commit message claiming "100% standards met" is valid ONLY with a FRESH
# green receipt (written exclusively by verify-all.mjs on all-green).
msg_file="$1"
grep -q "100% standards met" "$msg_file" || exit 0
gd="$(git rev-parse --git-dir)"
r="$gd/verify-receipt.json"
[ -f "$r" ] || { echo "✖ commit-msg: '100% standards met' claimed but no green receipt — run pnpm verify, then pnpm verify:stamp" >&2; exit 1; }
now="$(date +%s)"
mt="$(stat -f %m "$r" 2>/dev/null || stat -c %Y "$r")"
[ $((now - mt)) -le 600 ] || { echo "✖ commit-msg: green receipt is stale (>10 min) — re-run pnpm verify, then pnpm verify:stamp" >&2; exit 1; }
