#!/usr/bin/env sh
# ────────────────────────────────────────────────────────────────
# DO NOT EDIT — generated by install-slice-gates.sh
# ────────────────────────────────────────────────────────────────
# Pre-push — the 100%-standards mechanical gate. NO bypass exists:
# every check below must pass or the push is refused.
#   1. No direct push to main — main moves only via PR merge.
#   2. Branch name matches (feat|fix)/NNNN-kebab-slug.
#   3. Every pushed commit: conventional type + subject ≤ 65 chars
#      (headroom so GitHub's " (#NNN)" squash suffix stays ≤ 72).
#   4. Today's conversations log exists (docs/conversations/).
#   5. Outgoing HEAD is a '100% standards met' stamp commit.
#   6. pnpm verify exits 0 (verifier Mode B).

set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() { echo "✖ pre-push gate: $1" >&2; exit 1; }

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      fail "direct pushes to main are forbidden — main moves only via PR merge" ;;
  esac
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  branch="${remote_ref#refs/heads/}"
  echo "$branch" | grep -Eq '^(feat|fix)/[0-9]{4}-[a-z0-9][a-z0-9-]*$' \
    || fail "branch '$branch' violates (feat|fix)/NNNN-kebab-slug"

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha --not origin/main"
  else
    range="$remote_sha..$local_sha"
  fi
  for c in $(git rev-list $range 2>/dev/null); do
    subj="$(git log -1 --format=%s "$c")"
    echo "$subj" | grep -Eq '^(feat|fix|docs|style|refactor|test|chore): .+' \
      || fail "commit $c subject lacks '<type>: <subject>': '$subj'"
    n="$(printf %s "$subj" | wc -m | tr -d ' ')"
    [ "$n" -le 65 ] \
      || fail "commit $c subject is $n chars (max 65 — squash headroom): '$subj'"
  done

  today="$(date -u +%Y-%m-%d)"
  [ -f "$ROOT/docs/conversations/DAILY_CONVERSATION_$today.md" ] \
    || fail "docs/conversations/DAILY_CONVERSATION_$today.md missing — write the session log before pushing (Tier-1)"

  # 6. Outgoing HEAD must be a '100% standards met' stamp commit
  #    (created only by stamp-standards-met.mjs with a fresh green receipt;
  #    the commit-msg hook refuses hand-typed stamps).
  git log -1 --format=%B "$local_sha" | grep -q "100% standards met" \
    || fail "outgoing HEAD is not a '100% standards met' stamp — run: pnpm verify && pnpm verify:stamp, then push"
done

# Run in the app's code-subdir — baked in by install-slice-gates.sh (WEB_SUBDIR).
cd "$ROOT/code/package"
echo "▶ pre-push: shape checks green — running pnpm verify…"
pnpm verify
